<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hikâye Yönetimi - Okuma Geliştirme</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

        body {
            font-family: 'Poppins', sans-serif;
        }

        .gradient-bg {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
    </style>
</head>

<body class="bg-gray-50">
    <!-- Navigation -->
    <nav class="bg-white shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a href="dashboard.html" class="text-purple-600 hover:text-purple-700 mr-4">
                        <i class="fas fa-arrow-left text-xl"></i>
                    </a>
                    <span class="text-xl font-bold text-gray-800">Hikâye Yönetimi</span>
                </div>
                <div class="flex items-center space-x-4">
                    <div class="text-right">
                        <p class="text-sm font-semibold text-gray-800" id="userName">Yükleniyor...</p>
                    </div>
                    <button onclick="performLogout()" class="text-red-600 hover:text-red-700">
                        <i class="fas fa-sign-out-alt text-xl"></i>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <!-- Header -->
        <div class="flex justify-between items-center mb-8">
            <div>
                <h1 class="text-3xl font-bold text-gray-800">Hikâye Yönetimi</h1>
                <p class="text-gray-600 mt-2">Hikâye ekle, düzenle veya sil</p>
            </div>
            <button onclick="showAddModal()"
                class="gradient-bg text-white px-6 py-3 rounded-lg hover:opacity-90 transition">
                <i class="fas fa-plus mr-2"></i>Yeni Hikâye Ekle
            </button>
        </div>

        <!-- Filter -->
        <div class="bg-white rounded-xl shadow-md p-4 mb-6">
            <div class="flex items-center space-x-4">
                <label class="text-gray-700 font-semibold">Sınıf Seviyesi:</label>
                <button onclick="filterStories(null)" class="filter-btn px-4 py-2 rounded-lg bg-purple-600 text-white">
                    Tümü
                </button>
                <button onclick="filterStories(2)"
                    class="filter-btn px-4 py-2 rounded-lg bg-gray-200 text-gray-700 hover:bg-gray-300">
                    2. Sınıf
                </button>
                <button onclick="filterStories(3)"
                    class="filter-btn px-4 py-2 rounded-lg bg-gray-200 text-gray-700 hover:bg-gray-300">
                    3. Sınıf
                </button>
                <button onclick="filterStories(4)"
                    class="filter-btn px-4 py-2 rounded-lg bg-gray-200 text-gray-700 hover:bg-gray-300">
                    4. Sınıf
                </button>
            </div>
        </div>

        <!-- Stories List -->
        <div id="storiesContainer" class="space-y-4">
            <div class="text-center py-12">
                <i class="fas fa-spinner fa-spin text-4xl text-purple-600"></i>
                <p class="text-gray-600 mt-4">Hikâyeler yükleniyor...</p>
            </div>
        </div>
    </div>

    <!-- Add/Edit Story Modal -->
    <div id="storyModal"
        class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50 overflow-y-auto">
        <div class="bg-white rounded-xl shadow-2xl max-w-3xl w-full mx-4 my-8">
            <div class="gradient-bg text-white p-6 rounded-t-xl">
                <h2 class="text-2xl font-bold" id="modalTitle">Yeni Hikâye Ekle</h2>
            </div>

            <form id="storyForm" class="p-6 space-y-6">
                <input type="hidden" id="storyId">

                <!-- Title -->
                <div>
                    <label class="block text-gray-700 font-semibold mb-2">Hikâye Başlığı *</label>
                    <input type="text" id="storyTitle" required
                        class="w-full border-2 border-gray-300 rounded-lg p-3 focus:border-purple-600 focus:outline-none"
                        placeholder="Örn: Kaybolan Top">
                </div>

                <!-- Grade Level -->
                <div>
                    <label class="block text-gray-700 font-semibold mb-2">Sınıf Düzeyi *</label>
                    <select id="storyGrade" required
                        class="w-full border-2 border-gray-300 rounded-lg p-3 focus:border-purple-600 focus:outline-none">
                        <option value="">Seçiniz...</option>
                        <option value="2">2. Sınıf</option>
                        <option value="3">3. Sınıf</option>
                        <option value="4">4. Sınıf</option>
                    </select>
                </div>

                <!-- Story Text -->
                <div>
                    <label class="block text-gray-700 font-semibold mb-2">Hikâye Metni *</label>
                    <textarea id="storyText" required rows="12"
                        class="w-full border-2 border-gray-300 rounded-lg p-3 focus:border-purple-600 focus:outline-none"
                        placeholder="Hikâye metnini buraya yazın..."></textarea>
                    <p class="text-sm text-gray-500 mt-2">
                        <i class="fas fa-info-circle mr-1"></i>
                        Kelime sayısı otomatik hesaplanacak
                    </p>
                </div>

                <!-- Cover Image -->
                <div>
                    <label class="block text-gray-700 font-semibold mb-2">Kapak Görseli (Opsiyonel)</label>
                    <input type="file" id="coverImage" accept="image/*"
                        class="w-full border-2 border-gray-300 rounded-lg p-3">
                    <p class="text-sm text-gray-500 mt-2">JPG, PNG veya WebP formatında</p>
                </div>

                <!-- Audio File -->
                <div>
                    <label class="block text-gray-700 font-semibold mb-2">Ses Dosyası (Opsiyonel)</label>
                    <input type="file" id="audioFile" accept="audio/*"
                        class="w-full border-2 border-gray-300 rounded-lg p-3">
                    <p class="text-sm text-gray-500 mt-2">MP3 formatında</p>
                </div>

                <!-- Buttons -->
                <div class="flex space-x-4">
                    <button type="submit"
                        class="flex-1 gradient-bg text-white py-3 rounded-lg font-semibold hover:opacity-90 transition">
                        <i class="fas fa-save mr-2"></i>
                        <span id="submitBtnText">Kaydet</span>
                    </button>
                    <button type="button" onclick="closeModal()"
                        class="flex-1 bg-gray-300 text-gray-700 py-3 rounded-lg font-semibold hover:bg-gray-400 transition">
                        <i class="fas fa-times mr-2"></i>İptal
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="deleteModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
        <div class="bg-white rounded-xl shadow-2xl max-w-md w-full mx-4 p-6">
            <div class="text-center">
                <div class="inline-block bg-red-100 rounded-full p-4 mb-4">
                    <i class="fas fa-exclamation-triangle text-4xl text-red-600"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-800 mb-2">Hikâyeyi Sil</h3>
                <p class="text-gray-600 mb-6">Bu hikâyeyi silmek istediğinizden emin misiniz? Bu işlem geri alınamaz!
                </p>

                <div class="flex space-x-3">
                    <button onclick="confirmDelete()"
                        class="flex-1 bg-red-600 text-white py-3 rounded-lg font-semibold hover:bg-red-700 transition">
                        <i class="fas fa-trash mr-2"></i>Evet, Sil
                    </button>
                    <button onclick="closeDeleteModal()"
                        class="flex-1 bg-gray-300 text-gray-700 py-3 rounded-lg font-semibold hover:bg-gray-400 transition">
                        İptal
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="../js/api.js"></script>
    <script src="../js/auth.js"></script>
    <script>
        // Check authentication
        if (!checkAuth()) {
            window.location.href = '../login.html';
        }

        const user = getCurrentUserInfo();
        if (user.rol !== 'yonetici' && user.rol !== 'ogretmen') {
            alert('Bu sayfaya erişim yetkiniz yok!');
            window.location.href = '../login.html';
        }

        document.getElementById('userName').textContent = user.ad_soyad;

        let allStories = [];
        let currentFilter = null;
        let storyToDelete = null;

        // Load stories
        async function loadStories() {
            try {
                allStories = await API.getStories();
                displayStories();
            } catch (error) {
                console.error('Error loading stories:', error);
                document.getElementById('storiesContainer').innerHTML = `
                    <div class="text-center py-12">
                        <i class="fas fa-exclamation-triangle text-4xl text-red-600"></i>
                        <p class="text-red-600 mt-4">Hikâyeler yüklenirken hata oluştu!</p>
                    </div>
                `;
            }
        }

        function displayStories() {
            const container = document.getElementById('storiesContainer');

            let filteredStories = allStories;
            if (currentFilter) {
                filteredStories = allStories.filter(s => s.sinif_duzeyi === currentFilter);
            }

            if (filteredStories.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12">
                        <i class="fas fa-book-open text-6xl text-gray-300 mb-4"></i>
                        <p class="text-gray-600">Henüz hikâye bulunmuyor.</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = filteredStories.map(story => `
                <div class="bg-white rounded-xl shadow-md p-6 hover:shadow-lg transition">
                    <div class="flex items-start justify-between">
                        <div class="flex-1">
                            <div class="flex items-center space-x-3 mb-3">
                                <h3 class="text-xl font-bold text-gray-800">${story.baslik}</h3>
                                <span class="bg-purple-100 text-purple-800 text-xs px-3 py-1 rounded-full">
                                    ${story.sinif_duzeyi}. Sınıf
                                </span>
                                ${story.ses_dosyasi ? '<i class="fas fa-volume-up text-blue-600" title="Ses dosyası var"></i>' : ''}
                                ${story.kapak_gorseli ? '<i class="fas fa-image text-green-600" title="Kapak görseli var"></i>' : ''}
        function filterStories(grade) {
            currentFilter = grade;

            // Update button styles
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.remove('bg-purple-600', 'text-white');
                btn.classList.add('bg-gray-200', 'text-gray-700');
            });
            event.target.classList.remove('bg-gray-200', 'text-gray-700');
            event.target.classList.add('bg-purple-600', 'text-white');

            displayStories();
        }

        function showAddModal() {
            document.getElementById('modalTitle').textContent = 'Yeni Hikâye Ekle';
            document.getElementById('submitBtnText').textContent = 'Kaydet';
            document.getElementById('storyForm').reset();
            document.getElementById('storyId').value = '';
            document.getElementById('storyModal').classList.remove('hidden');
            document.getElementById('storyModal').classList.add('flex');
        }

        async function editStory(id) {
            const story = allStories.find(s => s.id === id);
            if (!story) return;

            document.getElementById('modalTitle').textContent = 'Hikâyeyi Düzenle';
            document.getElementById('submitBtnText').textContent = 'Güncelle';
            document.getElementById('storyId').value = story.id;
            document.getElementById('storyTitle').value = story.baslik;
            document.getElementById('storyGrade').value = story.sinif_duzeyi;
            document.getElementById('storyText').value = story.metin;

            document.getElementById('storyModal').classList.remove('hidden');
            document.getElementById('storyModal').classList.add('flex');
        }

        function deleteStory(id) {
            storyToDelete = id;
            document.getElementById('deleteModal').classList.remove('hidden');
            document.getElementById('deleteModal').classList.add('flex');
        }

        async function confirmDelete() {
            try {
                const response = await fetch(`http://localhost:8000/api/stories/${storyToDelete}`, {
                method: 'DELETE',
                headers: {
                'Authorization': `Bearer ${getAuthToken()}`
            }
                });

        if (response.ok) {
            alert('Hikâye başarıyla silindi!');
            closeDeleteModal();
            loadStories();
        } else {
            document.getElementById('deleteModal').classList.add('hidden');
            document.getElementById('deleteModal').classList.remove('flex');
            storyToDelete = null;
        }

        // Handle form submission
        document.getElementById('storyForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            const storyId = document.getElementById('storyId').value;
            const storyData = {
                baslik: document.getElementById('storyTitle').value,
                sinif_duzeyi: parseInt(document.getElementById('storyGrade').value),
                metin: document.getElementById('storyText').value
            };

            try {
                let result;
                if (storyId) {
                    // Update existing story
                    result = await API.updateStory(storyId, storyData);
                } else {
                    // Create new story
                    result = await API.createStory(storyData);
                }

                // Upload cover image if provided
                const coverFile = document.getElementById('coverImage').files[0];
                if (coverFile) {
                    await API.uploadCover(result.id, coverFile);
                }

                // Upload audio file if provided
                const audioFile = document.getElementById('audioFile').files[0];
                if (audioFile) {
                    await API.uploadAudio(result.id, audioFile);
                }

                alert(storyId ? 'Hikâye güncellendi!' : 'Hikâye eklendi!');
                closeModal();
                loadStories();
            } catch (error) {
                console.error('Error saving story:', error);
                alert('Hikâye kaydedilirken hata oluştu!');
            }
        });

        // Initialize
        loadStories();
    </script>
</body>

</html>